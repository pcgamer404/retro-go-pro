list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/threads-stub")

set(ASAN OFF)
set(UBSAN OFF)
set(DIST ON)
set(BUILD_TESTING OFF)
set(CPACK OFF)
set(BUILD_ASSETS_MPQ OFF)
set(UNPACKED_MPQS OFF)
set(UNPACKED_SAVES ON)

set(NONET ON)
set(PACKET_ENCRYPTION OFF)
set(DISABLE_TCP ON)
set(DISABLE_ZERO_TIER ON)
set(DEFAULT_PER_PIXEL_LIGHTING false)

set(DEVILUTIONX_SYSTEM_BZIP2 OFF)
set(DEVILUTIONX_SYSTEM_ZLIB OFF)
set(DEVILUTIONX_STATIC_ZLIB ON)
set(DEVILUTIONX_SYSTEM_LIBSODIUM OFF)
set(DEVILUTIONX_SYSTEM_SHEENBIDI OFF)
set(DEVILUTIONX_SYSTEM_UNORDERED_DENSE OFF)
set(DEVILUTIONX_SYSTEM_LUA OFF)
set(DEVILUTIONX_STATIC_LUA ON)

set(USE_SDL1 ON)
set(NOSOUND ON)

set(DEFAULT_WIDTH 640)
set(DEFAULT_HEIGHT 480)
set(SDL1_VIDEO_MODE_BPP 8)
set(SDL1_FORCE_SVID_VIDEO_MODE OFF)
set(SDL1_FORCE_DIRECT_RENDER ON)

set(PREFILL_PLAYER_NAME ON)
set(NOEXIT ON)
set(HAS_KBCTRL 1)
set(DEVILUTIONX_GAMEPAD_TYPE Xbox)
set(KBCTRL_BUTTON_DPAD_LEFT SDLK_LEFT)
set(KBCTRL_BUTTON_DPAD_RIGHT SDLK_RIGHT)
set(KBCTRL_BUTTON_DPAD_UP SDLK_UP)
set(KBCTRL_BUTTON_DPAD_DOWN SDLK_DOWN)
set(KBCTRL_BUTTON_A SDLK_SPACE)
set(KBCTRL_BUTTON_B SDLK_ESCAPE)
set(KBCTRL_BUTTON_X SDLK_TAB)
set(KBCTRL_BUTTON_Y SDLK_e)
set(KBCTRL_BUTTON_START SDLK_RETURN)
set(KBCTRL_BUTTON_BACK SDLK_RCTRL)
set(KBCTRL_BUTTON_RIGHTSHOULDER SDLK_t)
set(KBCTRL_BUTTON_LEFTSHOULDER SDLK_c)

set(RETROGO_LIB ON)

add_compile_options(-Wno-error -Wno-error=all -Wno-nonnull-compare -Wno-error=nonnull-compare -Wno-maybe-uninitialized -Wno-restrict -Wno-array-bounds -Wno-stringop-overflow -Wno-stringop-overread -Wno-dangling-reference)

add_compile_definitions(PROJECT_NAME="DevilutionX" RETROGO_LIB=1)
